{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "jobtask-frontend": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "ngx-build-plus:browser",
          "options": {
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "css",
            "assets": [],
            "styles": [
              "src/styles.css"
            ],
            "main": "src/main.ts",
            "outputPath": "dist/jobtask-frontend",
            "index": "src/index.html",
            "extraWebpackConfig": "webpack.config.js",
            "commonChunk": false
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "extraWebpackConfig": "webpack.config.js"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "ngx-build-plus:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "jobtask-frontend:build:production",
              "extraWebpackConfig": "webpack.config.js"
            },
            "development": {
              "buildTarget": "jobtask-frontend:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4008,
            "publicHost": "http://localhost:4008",
            "extraWebpackConfig": "webpack.config.js"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "d1b111d7-425e-4c2b-9a90-06af2ff1e47a"
  }
}
